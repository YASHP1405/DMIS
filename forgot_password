
{% extends "base.html" %}
{% block content %}
<section style="max-width:400px;margin:80px auto;padding:40px;text-align:center;background:#f9f9ff;border:2px solid darkviolet;border-radius:16px;">
    <h2>Forgot Password</h2>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
                <div class="alert alert-{{category}}">{{ message }}</div>
            {% endfor %}
        {% endif %}
    {% endwith %}

    <form method="POST" action="{{ url_for('forgot_password') }}">
        <div class="mb-3">
            <label for="short_code">Teacher Short Code</label>
            <input type="text" class="form-control" name="short_code" id="short_code" required>
        </div>
        <div class="mb-3">
            <label for="new_password">New Password</label>
            <input type="password" class="form-control" name="new_password" id="new_password" required>
        </div>
        <button type="submit" class="btn btn-dark w-100">Reset Password</button>
    </form>

    <div style="margin-top:15px;">
        <a href="{{ url_for('login') }}" style="text-decoration:none;color:darkviolet;font-weight:bold;">⬅ Back to Login</a>
    </div>
</section>
{% endblock %}
